{
  "version": 2,
  "framework": "nextjs",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/dashboard/(.*)",
      "headers": {
        "x-zhonnex-security-tier": "Enterprise-Core-Gate"
      },
      "dest": "/dashboard/$1"
    }
  ]
}
